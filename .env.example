# Copy to .env (never commit .env).

# --- Database (docker-compose.yml) -------------------------------------------
DB_PORT=54329
POSTGRES_SUPERUSER_PASSWORD=postgres_dev

# Administrator: used ONLY by scripts/db-roles.ts (first step of db:migrate) to create
# the database and the three roles below. Needs CREATEROLE and CREATEDB.
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev@localhost:54329/postgres

# The role names, passwords and database name in the next three URLs are what
# db-roles.ts creates. Change them here and re-run `npm run db:migrate`.

# The app connects with the restricted role (row-level security applies).
DATABASE_URL=postgres://wtp_app:wtp_app_dev@localhost:54329/wtp_sqms
# Auth layer only (Better Auth): can reach the auth tables and nothing else.
DATABASE_AUTH_URL=postgres://wtp_auth:wtp_auth_dev@localhost:54329/wtp_sqms
# Owner role: migrations and seed scripts ONLY. Never import this in src/.
DATABASE_OWNER_URL=postgres://wtp_owner:wtp_owner_dev@localhost:54329/wtp_sqms

# --- Auth (Better Auth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3100

# --- Email (Mailpit locally; real SMTP settings later) ------------------------
SMTP_HOST=localhost
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_NAME="نظام مراقبة جودة الخدمة / Service Quality Monitoring System"
SMTP_FROM_ADDRESS=no-reply@wtp.local
MAILPIT_UI_PORT=54326

# --- PDF export (Gotenberg container in docker-compose.yml) -------------------
PDF_PORT=54327
GOTENBERG_URL=http://localhost:54327
