{
  "name": "wtp-sqms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project=unit",
    "test:db": "vitest run --project=db",
    "test:all": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:migrate": "tsx scripts/db-roles.ts && drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/db-drop.ts && npm run db:migrate && tsx scripts/seed.ts",
    "clean": "tsx scripts/clean.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "better-auth": "^1.7.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-intl": "^4.14.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
